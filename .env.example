# Copy to .env and adjust. Every setting is optional.

# Bearer token required for /api/* and /mcp (except /api/health). Leave empty for no auth.
# Generate one with: openssl rand -hex 24
API_TOKEN=

# Which robot to control: its name as shown in the Roborock app, or its DUID.
# Empty = the first supported vacuum on the account.
ROBOROCK_DEVICE=

# Pre-fills the login form / CLI prompt. Not needed after the first login.
ROBOROCK_EMAIL=

# Port for the web UI, REST API and MCP endpoint.
PORT=8083

# Seconds to reuse a status reading before asking the robot again.
STATUS_CACHE_SECONDS=5

# Enable POST /api/command and the send_raw_command MCP tool.
ALLOW_RAW_COMMANDS=false

LOG_LEVEL=INFO
